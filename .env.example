# Official Docker Hub release tags plus immutable multi-architecture manifest digests.
# Review docs/UPSTREAM.md before changing either pin.
ASTRBOT_IMAGE=soulter/astrbot:v4.28.2@sha256:2215f337de16535953df936adaf34a36663d062d85b7ecffe06cdaed74f7b299
NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.18.33@sha256:147cb18a758aa5a4dc8ef4b310e532b1dd68371a93c2e7e5bb2022aa12a05328

# Bind admin UIs to loopback by default. Change only when you have a secured network path.
ASTRBOT_WEBUI_BIND=127.0.0.1
ASTRBOT_WEBUI_PORT=6185
NAPCAT_WEBUI_BIND=127.0.0.1
NAPCAT_WEBUI_PORT=6099

# Container timezone (IANA name)
TZ=Asia/Shanghai

# NapCat container user IDs; Docker Desktop on Windows may keep these defaults.
NAPCAT_UID=1000
NAPCAT_GID=1000

# Replace with a real key in your ignored .env file. Never commit it.
DEEPSEEK_API_KEY=replace-me
