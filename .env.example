# Docker images. AstrBot upstream currently documents :latest for Compose.
ASTRBOT_IMAGE=soulter/astrbot:latest
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest

# Bind admin UIs to loopback by default. Change only when you have a secured network path.
ASTRBOT_WEBUI_BIND=127.0.0.1
ASTRBOT_WEBUI_PORT=6185
NAPCAT_WEBUI_BIND=127.0.0.1
NAPCAT_WEBUI_PORT=6099

# Container timezone (IANA name)
TZ=Asia/Shanghai

# NapCat container user IDs; Docker Desktop on Windows may keep these defaults.
NAPCAT_UID=1000
NAPCAT_GID=1000

# Replace with a real key in your ignored .env file. Never commit it.
DEEPSEEK_API_KEY=replace-me
